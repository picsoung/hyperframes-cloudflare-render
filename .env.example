# Copy to .env (gitignored) and fill in.
# `npm run setup` populates these automatically after a guided bootstrap.

# Public URL prefix of the R2 bucket holding the heavy assets (videos + audio).
# Get it from: Cloudflare dashboard → R2 → hackbarna-aftermovie-assets →
# Settings → R2.dev subdomain → Allow Access.
R2_ASSETS_BASE=https://pub-<hash>.r2.dev

# Optional override — defaults to whatever `wrangler deployments list` returns
# WORKER_URL=https://hyperframes-on-cloudflare.<sub>.workers.dev
